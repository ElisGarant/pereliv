# Токен бота от @BotFather
BOT_TOKEN=
# Имя бота без @, для реф-ссылок
BOT_USERNAME=
# Supabase: Project Settings → Database → Connection string (URI), схема postgresql+asyncpg://
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Адрес, где открыт Mini App (https, его же указываешь в @BotFather)
WEBAPP_URL=https://example.com
# Telegram id админов через запятую
ADMIN_IDS=
# Разрешить заголовок X-Dev-User. Только для локальной разработки, на сервере false
DEV_MODE=false
CORS_ORIGINS=https://example.com

# Расшифровка голосовых (OpenAI-совместимый /audio/transcriptions). Пусто — бот скажет, что расшифровка не настроена
TRANSCRIBE_API_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1
